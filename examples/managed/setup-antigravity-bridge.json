{
  "session": "agy-isolated",
  "workspace_root": "./agy-workspaces",
  "sandbox": "bubblewrap",
  "broker_sandbox": "bubblewrap",
  "shared_board": true,
  "init_git": true,
  "agents": [
    {
      "id": "developer",
      "role": "Implement reviewed changes using your isolated Pi tools. Provider-native tools are unavailable.",
      "harness": "antigravity-bridge",
      "model": "gemini-3.8-flash-low",
      "auth": "api-env",
      "api_key_env": "AGENTMUX_AGY_BRIDGE_KEY",
      "base_url": "http://127.0.0.1:8097/v1",
      "conversation": "persistent",
      "network": "allowlist",
      "egress": { "allow": [{ "origin": "http://127.0.0.1:8097", "ips": ["127.0.0.1"] }] },
      "model_metadata": { "context_window": 8192, "max_output": 2048, "input": ["text"], "reasoning": false, "tools": true }
    }
  ]
}
